# Copy to backend/.env for local development. On Render, set these in the dashboard.
MONGO_URL=mongodb://localhost:27017
DB_NAME=dapperden
CORS_ORIGINS=*
# Leave empty to keep order emails mocked (logged only).
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
# Public site URL used for links in emails (no trailing slash).
SITE_URL=https://dapper-denn.netlify.app
# Optional: shown in emails and used as the reply-to address.
SUPPORT_EMAIL=
# Optional: where "New order" alerts go (the store owner).
ORDER_NOTIFY_EMAIL=
# Optional: long random secret that unlocks /api/admin/* (order list + status updates). Empty = disabled.
ADMIN_TOKEN=
